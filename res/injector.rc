#include <windows.h>

// Version info + a manifest that asks for comctl32 v6 (owner-draw ListView,
// RichEdit) and per-monitor DPI awareness.

#define IDI_APP_ICON 101
#define IDR_MANIFEST  102

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "oz"
            VALUE "FileDescription",  "Standalone x64 DLL injector"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "oz_injector"
            VALUE "OriginalFilename", "oz_injector.exe"
            VALUE "ProductName",      "oz injector"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_APP_ICON ICON "oz_injector.ico"

IDR_MANIFEST RT_MANIFEST "oz_injector.manifest"
